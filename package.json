{
  "name": "aethervr-player",
  "version": "1.12.13",
  "private": true,
  "author": "pipipiper <80835169+pipipiper@users.noreply.github.com>",
  "description": "AetherVR Player锛氫笉鐢?VR 鐪奸暅涔熻兘鐪?VR 瑙嗛銆傛湰鍦版枃浠朵笌鍦ㄧ嚎鐩撮摼鍗崇偣鍗虫挱锛屾敮鎸?360 鍏ㄦ櫙涓?SBS 鍒嗗睆",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "cc.pipp.aethervr",
    "productName": "AetherVR Player",
    "files": [
      "index.html",
      "server.js",
      "favicon.svg",
      "background-pic.jpg",
      "vendor/**",
      "electron/**",
      "build/icon.png",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "artifactName": "AetherVR-Player-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "AetherVR-Player-${version}-${arch}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}

